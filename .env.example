# Azure AI Foundry project and agent
FOUNDRY_PROJECT_ENDPOINT=https://johny03shams.services.ai.azure.com/api/projects/proj-default
FOUNDRY_AGENT_NAME=computerandlaptopsalesandserviceagent

# Local development can use `az login` instead.
# For Vercel, set these in Project Settings > Environment Variables.
# Grant this identity access to the Azure AI Foundry project.
AZURE_CLIENT_ID=your-application-client-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_SECRET=your-client-secret

# Alternatively, use an Azure OpenAI deployment with an API key.
# When these are configured, the assistant uses Azure OpenAI instead of Foundry.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
OPENAI_API_VERSION=2024-10-21
